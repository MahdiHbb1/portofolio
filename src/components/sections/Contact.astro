---
import { t } from '../../data/content';

const links = [
  {
    label: 'Email',
    value: 'mahdihabibi31352@gmail.com',
    href: 'mailto:mahdihabibi31352@gmail.com',
    mono: true,
  },
  {
    label: 'GitHub',
    value: 'MahdiHbb1',
    href: 'https://github.com/MahdiHbb1',
    mono: true,
  },
  {
    label: 'LinkedIn',
    value: 'Mahdi Habibi',
    href: 'https://linkedin.com/in/mahdi-habibi-62a939321/',
    mono: false,
  },
];
---

<section class="section contact" id="contact">
  <div class="container contact__inner reveal">

    <header class="contact__header">
      <p class="label" data-i18n="contact.label">Kontak</p>
      <h2 data-i18n="contact.heading">Hubungi Saya</h2>
      <p class="contact__sub" data-i18n="contact.subtitle">
        Terbuka untuk kolaborasi, diskusi CTF, atau sekadar ngobrol soal security dan ML.
      </p>
    </header>

    <ul class="contact__list" role="list">
      {links.map(l => (
        <li class="contact__row">
          <a href={l.href} class="contact__item"
             target={l.href.startsWith('mailto') ? undefined : '_blank'}
             rel={l.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}>
            <span class="contact__item-label label">{l.label}</span>
            <span class:list={['contact__item-value', { mono: l.mono }]}>{l.value}</span>
            <span class="contact__item-arrow" aria-hidden="true">↗</span>
          </a>
          {l.label === 'Email' && (
            <button
              class="contact__copy"
              data-copy={l.value}
              aria-label="Copy email address"
              title="Copy email">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <rect x="4" y="4" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M2 10V2h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>
          )}
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .contact__header {
    position: sticky;
    top: 2rem;
  }

  .contact__header h2 {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .contact__sub {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .contact__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .contact__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    background: var(--bg-raised);
    transition: background 160ms ease;
    position: relative;
  }

  .contact__item:hover {
    background: var(--bg-subtle);
  }

  .contact__item-label {
    width: 5rem;
    flex-shrink: 0;
  }

  .contact__item-value {
    color: var(--fg);
    font-size: 0.9rem;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact__item-value.mono {
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .contact__item-arrow {
    color: var(--fg-faint);
    font-size: 0.9rem;
    transition: color 160ms ease, transform 160ms ease;
  }

  .contact__item:hover .contact__item-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* Footer bawah halaman */
  .contact__footer {
    margin-top: var(--s-8);
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 680px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact__header {
      position: static;
    }
  }
</style>
