               0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
    </svg>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/mahdi-habibi-62a939321/',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708
               c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943
               12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248
               -.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521
               1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431
               .568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22
               -1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54
               0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
    </svg>`,
  },
  {
    label: 'Email',
    href: 'mailto:mahdihabibi31352@gmail.com',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="1" y="3" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M1 5l7 5 7-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>`,
  },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <span class="footer__copy">
      &copy; {year} Mahdi Habibi
    </span>

    <ul class="footer__socials" role="list" aria-label="Social links">
      {socials.map(s => (
        <li>
          <a href={s.href} class="footer__social-link"
             aria-label={s.label}
             target={s.href.startsWith('mailto') ? undefined : '_blank'}
             rel={s.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}>
            <Fragment set:html={s.icon} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 1.75rem;
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer__copy {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
    letter-spacing: 0.04em;
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--fg-faint);
    border-radius: 6px;
    transition: color 160ms ease, background 160ms ease;
  }

  .footer__social-link:hover {
    color: var(--fg);
    background: var(--bg-subtle);
  }
</style>
