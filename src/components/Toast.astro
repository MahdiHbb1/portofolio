---
// Toast notification system
---

<div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true">
</div>

<!-- is:global: runtime-created nodes miss Astro's scoped-style attribute. -->
<style is:global>
  .toast-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .toast-container {
      bottom: calc(64px + 1rem);
      left: 1rem;
      right: 1rem;
    }
  }

  .toast {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
    animation: toast-slide-in 300ms var(--ease-out-expo);
    min-width: 280px;
    max-width: 420px;
  }

  .toast.toast--success {
    border-color: rgba(107, 158, 120, 0.5);
  }

  .toast.toast--error {
    border-color: rgba(184, 92, 92, 0.5);
  }

  .toast.toast--info {
    border-color: var(--border-accent);
  }

  .toast__icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toast__icon--success { color: #6b9e78; }
  .toast__icon--error { color: #b85c5c; }
  .toast__icon--info { color: var(--accent); }

  .toast__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toast__title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--fg);
  }

  .toast__message {
    font-size: 0.8rem;
    color: var(--fg-muted);
    line-height: 1.4;
  }

  .toast__close {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-faint);
    border: none;
    background: none;
    cursor: pointer;
    transition: color 150ms ease;
    padding: 0;
  }

  .toast__close:hover {
    color: var(--fg);
  }

  @keyframes toast-slide-in {
    from {
      opacity: 0;
      transform: translateX(100px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .toast.toast--removing {
    animation: toast-slide-out 250ms ease forwards;
  }

  @keyframes toast-slide-out {
    to {
      opacity: 0;
      transform: translateX(100px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast {
      animation: none;
    }
    .toast.toast--removing {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  // Toast API
  type ToastType = 'success' | 'error' | 'info';

  interface ToastOptions {
    type?: ToastType;
    duration?: number;
    title?: string;
  }

  const icons = {
    success: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M16.25 5.625L7.5 14.375L3.75 10.625" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    error: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 6.25V10M10 13.75H10.01M18.75 10C18.75 14.8325 14.8325 18.75 10 18.75C5.16751 18.75 1.25 14.8325 1.25 10C1.25 5.16751 5.16751 1.25 10 1.25C14.8325 1.25 18.75 5.16751 18.75 10Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
    info: '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8.75" stroke="currentColor" stroke-width="1.5"/><path d="M10 10V13.75M10 6.25H10.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
  };

  function showToast(message: string, options: ToastOptions = {}) {
    const { type = 'info', duration = 4000, title } = options;
    
    const container = document.getElementById('toastContainer');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `toast toast--${type}`;
    
    toast.innerHTML = `
      <div class="toast__icon toast__icon--${type}">
        ${icons[type]}
      </div>
      <div class="toast__content">
        ${title ? `<div class="toast__title">${title}</div>` : ''}
        <div class="toast__message">${message}</div>
      </div>
      <button class="toast__close" aria-label="Close notification">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M12 4L4 12M4 4L12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    `;

    const closeBtn = toast.querySelector('.toast__close');
    closeBtn?.addEventListener('click', () => removeToast(toast));

    container.appendChild(toast);

    if (duration > 0) {
      setTimeout(() => removeToast(toast), duration);
    }
  }

  function removeToast(toast: HTMLElement) {
    toast.classList.add('toast--removing');
    setTimeout(() => toast.remove(), 250);
  }

  // Make available globally
  (window as any).showToast = showToast;

  // Example usage (remove this in production)
  // setTimeout(() => {
  //   showToast('Welcome to my portfolio!', { type: 'info', title: 'Hello' });
  // }, 1000);
</script>
