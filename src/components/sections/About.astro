---
import { t } from '../../data/content';
---

<section class="section about" id="about">
  <div class="container about__inner reveal">

    <header class="about__header">
      <p class="label" data-i18n="about.label">Tentang</p>
      <h2 class="about__heading" data-i18n="about.heading">Siapa Saya</h2>
      <div class="about__photo-placeholder" aria-label="Foto placeholder">
        <span class="photo-hint">Foto</span>
      </div>
    </header>

    <div class="about__body">
      <p class="about__bio" data-i18n="about.bio1">
        Mahasiswa Informatika di Universitas Negeri Semarang. Saat ini menjabat
        sebagai Kepala Divisi IT Security di CODELINES UKM RIPTEK UNNES dan
        aktif berkompetisi di Capture The Flag.
      </p>
      <p class="about__bio" data-i18n="about.bio2">
        Paralel dengan itu, mengerjakan bagian ML dan web development untuk
        SIGAP MBG, proyek PKM-KC yang sudah lolos pendanaan.
        Tertarik di persimpangan antara keamanan sistem, machine learning, dan
        produk yang bisa dipakai orang beneran.
      </p>

      <ul class="about__tags" aria-label="Area fokus">
        <li>IT Security</li>
        <li>Machine Learning</li>
        <li>CTF</li>
        <li>Web Development</li>
        <li>PKM-KC</li>
      </ul>
    </div>

  </div>
</section>

<style>
  .about__inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .about__header {
    position: sticky;
    top: 2rem;
  }

  .about__heading {
    color: var(--fg);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    margin-top: 0.25rem;
    margin-bottom: 0;
  }

  .about__photo-placeholder {
    margin-top: 1rem;
    width: 100%;
    aspect-ratio: 3 / 4;
    max-width: 16rem;
    border: 2px solid rgba(232, 224, 212, 0.3);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(160, 120, 80, 0.05) 0%, rgba(232, 224, 212, 0.03) 100%);
    position: relative;
    overflow: hidden;
    box-shadow: 
      0 0 20px rgba(160, 120, 80, 0.15),
      inset 0 0 20px rgba(232, 224, 212, 0.05);
  }

  .about__photo-placeholder::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 8px;
    padding: 2px;
    background: linear-gradient(135deg, 
      rgba(232, 224, 212, 0.4) 0%, 
      rgba(160, 120, 80, 0.6) 50%, 
      rgba(232, 224, 212, 0.4) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.7;
    animation: glow-pulse 3s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .about__photo-placeholder::before {
      animation: none;
      opacity: 0.7;
    }
  }

  .photo-hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    z-index: 1;
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 4rem;
  }

  .about__bio {
    color: var(--fg-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    max-width: none; /* kolom 2fr sudah membatasi lebar — max-width tidak perlu */
  }

  .about__bio strong {
    color: var(--fg);
    font-weight: 600;
  }

  .about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-top: 0.5rem;
  }

  .about__tags li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .about__header {
      position: static;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .about__photo-placeholder {
      margin-top: 1.5rem;
      margin-inline: auto;
    }

    .about__bio {
      font-size: 0.95rem;
    }
  }
</style>
