---
// OrbitGallery: interactive 3D project gallery
// State 1 (<=640px): disabled (section hidden on phones)
// State 2 (641-900px): Three.js full, camera z=10
// State 3 (>900px): Three.js full, camera z=7
import PanelDetailModal from './PanelDetailModal.astro';
---

<div class="orbit-root" aria-label="Interactive 3D project gallery">
  <canvas class="orbit-canvas" aria-hidden="true"></canvas>

  <button class="orbit-reset" aria-label="Reset camera position" title="Reset view">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M2 8a6 6 0 1 1 1.5 3.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <polyline points="2,12 2,8 6,8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <noscript>
    <p class="orbit-noscript">Enable JavaScript to view the interactive gallery.</p>
  </noscript>
</div>

<PanelDetailModal />

<style>
  .orbit-root {
    position: relative;
    width: 100%;
    height: 100dvh;
    background: #0f0e0d;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .orbit-root {
      display: none;
    }
  }

  .orbit-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .orbit-canvas:active {
    cursor: grabbing;
  }

  .orbit-reset {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(232, 224, 212, 0.06);
    border: 1px solid rgba(232, 224, 212, 0.14);
    border-radius: 6px;
    color: rgba(232, 224, 212, 0.55);
    cursor: pointer;
    padding: 0;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .orbit-reset:hover {
    background: rgba(160, 120, 80, 0.12);
    border-color: rgba(160, 120, 80, 0.35);
    color: rgba(232, 224, 212, 0.9);
    box-shadow: 0 0 16px rgba(160, 120, 80, 0.5);
  }

  .orbit-reset:focus-visible {
    outline: 2px solid rgba(160, 120, 80, 0.6);
    outline-offset: 2px;
    box-shadow: 0 0 20px rgba(160, 120, 80, 0.6);
  }

  .orbit-noscript {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e8e0d4;
    font-family: sans-serif;
    font-size: 0.875rem;
    opacity: 0.5;
  }
</style>

<script>
  let isInitialized = false;
  let currentCleanup: (() => void) | null = null;
  let lazyObserver: IntersectionObserver | null = null;
  let isFirstLoad = true;

  async function initOrbitGallery() {
    if (window.matchMedia('(max-width: 640px)').matches) {
      isInitialized = false;
      return;
    }

    const root = document.querySelector('.orbit-root');
    const canvas = root?.querySelector('.orbit-canvas');
    const resetBtn = root?.querySelector('.orbit-reset');

    if (!(canvas instanceof HTMLCanvasElement) || !canvas.isConnected) {
      isInitialized = false;
      return;
    }

    if (isInitialized) return;
    isInitialized = true;

    const lang = (localStorage.getItem('lang') as 'id' | 'en') || 'id';

    const [
      { createScene, startLoop },
      { createBlob },
      { createNebulae },
      { createStarfield },
      { createPanels },
      { createLines },
      { createControls },
      { createAsteroids },
      { createShootingStars },
    ] = await Promise.all([
      import('./orbit/scene.ts'),
      import('./orbit/blob.ts'),
      import('./orbit/nebula.ts'),
      import('./orbit/starfield.ts'),
      import('./orbit/panels.ts'),
      import('./orbit/lines.ts'),
      import('./orbit/controls.ts'),
      import('./orbit/asteroids.ts'),
      import('./orbit/shooting-stars.ts'),
    ]);

    if (!canvas.isConnected) {
      isInitialized = false;
      return;
    }

    const isState2 = window.matchMedia('(max-width: 900px)').matches;
    const ctx = createScene(canvas, isState2 ? 10 : 7);

    const nebulae = createNebulae(ctx);
    const starfield = createStarfield(ctx);
    const blob = createBlob(ctx);
    const asteroids = createAsteroids(ctx);
    const shootingStars = createShootingStars(ctx);
    const panels = createPanels(ctx, { lang });
    const lines = createLines(ctx, panels);
    const controls = createControls(
      ctx,
      resetBtn instanceof HTMLElement ? resetBtn : null,
      panels,
      { lang },
    );

    const mq = window.matchMedia('(max-width: 900px)');
    function onBreakpointChange(e: MediaQueryListEvent) {
      if (!controls.isInspecting()) {
        ctx.camera.position.setZ(e.matches ? 10 : 7);
        controls.tick();
      }
    }
    mq.addEventListener('change', onBreakpointChange);

    let orbitTime = 0;
    const stopLoop = startLoop(ctx, (elapsed, delta) => {
      if (!controls.isInspecting()) {
        orbitTime += Math.min(delta, 0.1);
      }
      nebulae.tick(elapsed);
      starfield.tick(elapsed);
      blob.tick(elapsed);
      asteroids.tick(elapsed);
      shootingStars.tick(elapsed);
      panels.tick(orbitTime, ctx.camera);
      lines.tick(elapsed);
      controls.tick();
    });

    const cleanup = () => {
      mq.removeEventListener('change', onBreakpointChange);
      stopLoop();
      controls.dispose();
      lines.dispose();
      panels.dispose();
      shootingStars.dispose();
      asteroids.dispose();
      blob.dispose();
      starfield.dispose();
      nebulae.dispose();
      ctx.dispose();
      currentCleanup = null;
      isInitialized = false;
    };

    currentCleanup = cleanup;
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  // Lazy-init when gallery approaches viewport to keep initial load TBT at 0ms.
  function setupLazyInit() {
    currentCleanup?.();
    if (window.matchMedia('(max-width: 640px)').matches) return;

    const root = document.querySelector('.orbit-root');
    if (!(root instanceof HTMLElement)) return;

    lazyObserver?.disconnect();
    lazyObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        lazyObserver?.disconnect();
        lazyObserver = null;
        void initOrbitGallery();
      },
      { rootMargin: '300px 0px' },
    );
    lazyObserver.observe(root);

    document.addEventListener(
      'astro:before-swap',
      () => {
        lazyObserver?.disconnect();
        lazyObserver = null;
      },
      { once: true },
    );
  }

  setupLazyInit();

  document.addEventListener('astro:page-load', () => {
    if (isFirstLoad) {
      isFirstLoad = false;
      return;
    }
    setupLazyInit();
  });
</script>
