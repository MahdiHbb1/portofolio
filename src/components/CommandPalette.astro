---
// Command Palette - Keyboard-first navigation (Cmd/Ctrl + K)
---

<div class="command-palette" id="commandPalette" aria-label="Command palette" role="dialog" aria-modal="true">
  <div class="command-palette__backdrop"></div>
  
  <div class="command-palette__panel">
    <div class="command-palette__header">
      <div class="command-palette__search">
        <svg class="command-palette__search-icon" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/>
          <path d="M12.5 12.5L16 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input 
          type="text" 
          id="commandPaletteInput"
          name="command-search"
          class="command-palette__input" 
          placeholder="Type a command or search..."
          aria-label="Search commands"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="command-palette__close-hint">Esc</kbd>
      </div>
    </div>

    <div class="command-palette__content">
      <div class="command-palette__empty" style="display: none;">
        <p>No commands found</p>
      </div>

      <div class="command-palette__results">
        <!-- Populated by JS -->
      </div>
    </div>

    <div class="command-palette__footer">
      <div class="command-palette__hints">
        <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span><kbd>Enter</kbd> Execute</span>
        <span><kbd>Esc</kbd> Close</span>
      </div>
    </div>
  </div>
</div>

<!-- is:global: runtime-created nodes miss Astro's scoped-style attribute. -->
<style is:global>
  .command-palette {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(4rem, 12vh, 8rem);
    padding-inline: 1rem;
  }

  .command-palette.is-open {
    display: flex;
  }

  .command-palette__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 14, 13, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fade-in 200ms ease;
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .command-palette__panel {
    position: relative;
    width: 100%;
    max-width: 640px;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6);
    animation: slide-in 250ms var(--ease-out-expo);
    overflow: hidden;
  }

  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateY(-20px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Header */
  .command-palette__header {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .command-palette__search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 200ms ease;
  }

  .command-palette__search:focus-within {
    border-color: var(--border-accent);
  }

  .command-palette__search-icon {
    flex-shrink: 0;
    color: var(--fg-muted);
  }

  .command-palette__input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--fg);
    font-size: 0.95rem;
    font-family: var(--font-sans);
  }

  .command-palette__input::placeholder {
    color: var(--fg-faint);
  }

  .command-palette__close-hint {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--fg-muted);
  }

  /* Content */
  .command-palette__content {
    max-height: 400px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .command-palette__content::-webkit-scrollbar {
    width: 8px;
  }

  .command-palette__content::-webkit-scrollbar-track {
    background: var(--bg-raised);
  }

  .command-palette__content::-webkit-scrollbar-thumb {
    background: var(--bg-subtle);
    border-radius: 4px;
  }

  .command-palette__content::-webkit-scrollbar-thumb:hover {
    background: var(--accent-dim);
  }

  .command-palette__empty {
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  /* Results */
  .command-palette__results {
    padding: 0.5rem;
  }

  .command-palette__category {
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .command-palette__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 150ms ease;
    text-decoration: none;
    color: var(--fg);
  }

  .command-palette__item:hover,
  .command-palette__item.is-selected {
    background: var(--accent-dim);
  }

  .command-palette__item.is-selected {
    border: 1px solid var(--border-accent);
  }

  .command-palette__item-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: var(--fg-muted);
  }

  .command-palette__item.is-selected .command-palette__item-icon {
    color: var(--accent);
  }

  .command-palette__item-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .command-palette__item-label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .command-palette__item-description {
    font-size: 0.75rem;
    color: var(--fg-faint);
  }

  .command-palette__item-shortcut {
    flex-shrink: 0;
    display: flex;
    gap: 0.25rem;
  }

  .command-palette__item-shortcut kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.2rem 0.4rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--fg-muted);
  }

  /* Footer */
  .command-palette__footer {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .command-palette__hints {
    display: flex;
    gap: 1.5rem;
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .command-palette__hints kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.2rem 0.4rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 3px;
    margin-inline: 0.25rem;
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .command-palette {
      padding-top: 2rem;
      align-items: stretch;
    }

    .command-palette__panel {
      max-width: 100%;
      height: 100%;
      border-radius: 12px 12px 0 0;
      animation: slide-up 250ms var(--ease-out-expo);
    }

    @keyframes slide-up {
      from {
        opacity: 0;
        transform: translateY(50px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .command-palette__content {
      max-height: calc(100vh - 250px);
    }

    .command-palette__hints {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
  }

  /* Animations */
  @media (prefers-reduced-motion: reduce) {
    .command-palette__backdrop,
    .command-palette__panel {
      animation: none;
    }
  }
</style>

<script>
  import Fuse from 'fuse.js';
  import { nanoid } from 'nanoid';
  import { navigate } from 'astro:transitions/client';

  interface Command {
    id: string;
    label: string;
    description?: string;
    category: 'Navigation' | 'Action' | 'Social';
    keywords: string[];
    icon: string;
    action: () => void;
    shortcut?: string;
  }

  class CommandPalette {
    private palette: HTMLElement;
    private backdrop: HTMLElement;
    private input: HTMLInputElement;
    private results: HTMLElement;
    private empty: HTMLElement;
    private commands: Command[] = [];
    private fuse!: Fuse<Command>;
    private selectedIndex: number = 0;
    private isOpen: boolean = false;
    private lastCompactViewport: boolean | null = null;

    constructor() {
      this.palette = document.getElementById('commandPalette')!;
      this.backdrop = this.palette.querySelector('.command-palette__backdrop')!;
      this.input = this.palette.querySelector('.command-palette__input')!;
      this.results = this.palette.querySelector('.command-palette__results')!;
      this.empty = this.palette.querySelector('.command-palette__empty')!;

      this.initCommands();
      this.setupFuse();
      this.setupEventListeners();
      this.render();
    }

    private initCommands() {
      const isCompact = window.matchMedia('(max-width: 640px)').matches;
      this.lastCompactViewport = isCompact;

      const navigationCommands: Command[] = [
        {
          id: nanoid(),
          label: 'About',
          description: 'Learn about Mahdi',
          category: 'Navigation',
          keywords: ['about', 'bio', 'info', 'me'],
          icon: 'user',
          action: () => this.scrollTo('#about'),
        },
        ...(isCompact
          ? []
          : [
              {
                id: nanoid(),
                label: '3D Gallery',
                description: 'View interactive project gallery',
                category: 'Navigation' as const,
                keywords: ['gallery', '3d', 'projects', 'orbit', 'showcase'],
                icon: 'cube',
                action: () => this.scrollTo('#gallery'),
              },
            ]),
        {
          id: nanoid(),
          label: 'Skills',
          description: 'Technical expertise',
          category: 'Navigation',
          keywords: ['skills', 'tech', 'expertise', 'tools'],
          icon: 'code',
          action: () => this.scrollTo('#skills'),
        },
        {
          id: nanoid(),
          label: 'Projects',
          description: 'Portfolio work',
          category: 'Navigation',
          keywords: ['projects', 'work', 'portfolio', 'showcase'],
          icon: 'folder',
          action: () => this.scrollTo('#projects'),
        },
        {
          id: nanoid(),
          label: 'Achievements',
          description: 'Awards and recognition',
          category: 'Navigation',
          keywords: ['achievements', 'awards', 'recognition', 'ctf', 'pkm'],
          icon: 'trophy',
          action: () => this.scrollTo('#achievements'),
        },
        {
          id: nanoid(),
          label: 'Writeups',
          description: 'CTF writeups and security walkthroughs',
          category: 'Navigation',
          keywords: ['writeups', 'ctf', 'security', 'walkthrough'],
          icon: 'shield',
          action: () => this.scrollTo('#writeups'),
        },
        {
          id: nanoid(),
          label: 'Terminal',
          description: 'Scroll to interactive terminal playground',
          category: 'Navigation',
          keywords: ['terminal', 'playground', 'shell', 'ctf'],
          icon: 'terminal',
          action: () => this.scrollTo('#terminal'),
        },
        {
          id: nanoid(),
          label: 'Contact',
          description: 'Get in touch',
          category: 'Navigation',
          keywords: ['contact', 'email', 'reach', 'connect'],
          icon: 'mail',
          action: () => this.scrollTo('#contact'),
        },
      ];

      this.commands = [
        // Navigation
        ...navigationCommands,

        // Actions
        {
          id: nanoid(),
          label: 'Copy Email',
          description: 'Copy email to clipboard',
          category: 'Action',
          keywords: ['email', 'copy', 'clipboard', 'contact'],
          icon: 'copy',
          action: () => this.copyEmail(),
        },
        {
          id: nanoid(),
          label: 'Download Resume (Coming soon)',
          description: 'CV/Resume PDF (Coming soon)',
          category: 'Action',
          keywords: ['resume', 'cv', 'download', 'pdf'],
          icon: 'download',
          action: () => this.downloadResume(),
        },
        {
          id: nanoid(),
          label: 'Open Terminal',
          description: 'Interactive shell (` to open)',
          category: 'Action',
          keywords: ['terminal', 'shell', 'console', 'cli', 'command'],
          icon: 'terminal',
          action: () => this.runTerminal(),
        },

        // Social
        {
          id: nanoid(),
          label: 'GitHub',
          description: 'View code repositories',
          category: 'Social',
          keywords: ['github', 'code', 'repos', 'open source'],
          icon: 'github',
          action: () => this.openLink('https://github.com/MahdiHbb1'),
        },
        {
          id: nanoid(),
          label: 'LinkedIn',
          description: 'Professional profile',
          category: 'Social',
          keywords: ['linkedin', 'profile', 'network', 'professional'],
          icon: 'linkedin',
          action: () => this.openLink('https://linkedin.com/in/mahdi-habibi-62a939321/'),
        },
      ];
    }

    private setupFuse() {
      this.fuse = new Fuse(this.commands, {
        keys: ['label', 'description', 'keywords'],
        threshold: 0.3,
        includeScore: true,
      });
    }

    private keydownHandler = (e: KeyboardEvent) => {
      // Cmd/Ctrl + K or /
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        this.toggle();
      } else if (e.key === '/' && !this.isOpen && document.activeElement?.tagName !== 'INPUT') {
        e.preventDefault();
        this.open();
      }

      // Navigation when open
      if (this.isOpen) {
        if (e.key === 'Escape') {
          e.preventDefault();
          this.close();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          this.selectNext();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          this.selectPrevious();
        } else if (e.key === 'Enter') {
          e.preventDefault();
          this.executeSelected();
        }
      }
    };

    public destroy() {
      document.removeEventListener('keydown', this.keydownHandler);
    }

    private setupEventListeners() {
      // Keyboard shortcuts
      document.addEventListener('keydown', this.keydownHandler);

      // Search input
      this.input.addEventListener('input', () => {
        this.search();
      });

      // Backdrop click
      this.backdrop.addEventListener('click', () => {
        this.close();
      });
    }

    private search() {
      const query = this.input.value.trim();
      
      if (!query) {
        this.render();
        return;
      }

      const results = this.fuse.search(query);
      const commands = results.map(r => r.item);
      
      if (commands.length === 0) {
        this.renderEmpty();
      } else {
        this.render(commands);
      }

      this.selectedIndex = 0;
      this.updateSelection();
    }

    private render(commands: Command[] = this.commands) {
      this.empty.style.display = 'none';
      
      // Group by category
      const grouped = commands.reduce((acc, cmd) => {
        if (!acc[cmd.category]) acc[cmd.category] = [];
        acc[cmd.category].push(cmd);
        return acc;
      }, {} as Record<string, Command[]>);

      this.results.innerHTML = '';

      let itemIndex = 0;
      Object.entries(grouped).forEach(([category, cmds]) => {
        const categoryEl = document.createElement('div');
        categoryEl.className = 'command-palette__category';
        categoryEl.textContent = category;
        this.results.appendChild(categoryEl);

        cmds.forEach((cmd) => {
          const item = this.createItem(cmd, itemIndex++);
          this.results.appendChild(item);
        });
      });

      this.updateSelection();
    }

    private renderEmpty() {
      this.empty.style.display = 'block';
      this.results.innerHTML = '';
    }

    private createItem(command: Command, index: number): HTMLElement {
      const item = document.createElement('div');
      item.className = 'command-palette__item';
      item.dataset.index = String(index);
      item.dataset.id = command.id;

      item.innerHTML = `
        <div class="command-palette__item-icon">
          ${this.getIcon(command.icon)}
        </div>
        <div class="command-palette__item-content">
          <div class="command-palette__item-label">${command.label}</div>
          ${command.description ? `<div class="command-palette__item-description">${command.description}</div>` : ''}
        </div>
        ${command.shortcut ? `<div class="command-palette__item-shortcut"><kbd>${command.shortcut}</kbd></div>` : ''}
      `;

      item.addEventListener('click', () => {
        this.selectedIndex = index;
        this.executeSelected();
      });

      item.addEventListener('mouseenter', () => {
        this.selectedIndex = index;
        this.updateSelection();
      });

      return item;
    }

    private getIcon(name: string): string {
      const icons: Record<string, string> = {
        user: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="6" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M3 15c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
        cube: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2l6 3.5v7L9 16l-6-3.5v-7L9 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>',
        code: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M6 5L2 9l4 4M12 5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
        folder: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 5h6l2 2h6v8H2V5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>',
        trophy: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M5 3h8v4c0 2.21-1.79 4-4 4s-4-1.79-4-4V3zM9 11v4M6 15h6M3 3v2c0 1.1.9 2 2 2M15 3v2c0 1.1-.9 2-2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
        mail: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="4" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M2 6l7 5 7-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>',
        copy: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="6" y="6" width="9" height="9" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M3 12V4c0-.6.4-1 1-1h8" stroke="currentColor" stroke-width="1.5"/></svg>',
        download: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 3v8M6 8l3 3 3-3M3 15h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
        shield: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2l6 2.5v4.2c0 3.4-2.55 6.45-6 7.3-3.45-.85-6-3.9-6-7.3V4.5L9 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>',
        terminal: '<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="3.5" width="14" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 7l2.5 2L5 11M9.5 11.5H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
        github: '<svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor"><path d="M9 1.5C4.86 1.5 1.5 4.86 1.5 9c0 3.31 2.15 6.12 5.13 7.11.38.07.51-.16.51-.36v-1.4c-2.09.45-2.53-1-2.53-1-.34-.87-.83-1.1-.83-1.1-.68-.47.05-.46.05-.46.75.05 1.15.77 1.15.77.67 1.15 1.75.82 2.18.63.07-.49.26-.82.48-1-1.66-.19-3.4-.83-3.4-3.69 0-.82.29-1.48.77-2-.08-.19-.33-.95.07-1.98 0 0 .63-.2 2.05.77.6-.17 1.24-.25 1.87-.25s1.28.08 1.87.25c1.42-.97 2.05-.77 2.05-.77.4 1.03.15 1.79.07 1.98.48.52.77 1.18.77 2 0 2.87-1.75 3.5-3.41 3.68.27.23.51.69.51 1.39v2.06c0 .2.13.43.52.36C14.35 15.12 16.5 12.31 16.5 9c0-4.14-3.36-7.5-7.5-7.5z"/></svg>',
        linkedin: '<svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor"><path d="M4.5 6h2.25v7.5H4.5V6zm1.125-3.375a1.313 1.313 0 110 2.625 1.313 1.313 0 010-2.625zM9.75 6h2.156v1.031h.031c.3-.569.938-1.031 1.969-1.031 2.063 0 2.344 1.313 2.344 3v4.5h-2.25V9.469c0-.844-.019-1.969-1.219-1.969-1.219 0-1.406.938-1.406 1.938v4.062H9.75V6z"/></svg>',
      };
      return icons[name] || icons.cube;
    }

    private selectNext() {
      const items = this.results.querySelectorAll('.command-palette__item');
      if (items.length === 0) return;
      
      this.selectedIndex = (this.selectedIndex + 1) % items.length;
      this.updateSelection();
    }

    private selectPrevious() {
      const items = this.results.querySelectorAll('.command-palette__item');
      if (items.length === 0) return;
      
      this.selectedIndex = (this.selectedIndex - 1 + items.length) % items.length;
      this.updateSelection();
    }

    private updateSelection() {
      const items = this.results.querySelectorAll('.command-palette__item');
      items.forEach((item, index) => {
        if (index === this.selectedIndex) {
          item.classList.add('is-selected');
          item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          item.classList.remove('is-selected');
        }
      });
    }

    private executeSelected() {
      const items = this.results.querySelectorAll('.command-palette__item');
      const selectedItem = items[this.selectedIndex] as HTMLElement;
      if (!selectedItem) return;

      const commandId = selectedItem.dataset.id;
      const command = this.commands.find(c => c.id === commandId);
      
      if (command) {
        void command.action();
        this.close();
      }
    }

    // Actions
    private async scrollTo(selector: string) {
      if (window.location.pathname !== '/' || !document.querySelector(selector)) {
        await navigate('/' + selector);
        window.setTimeout(() => {
          document.querySelector(selector)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 350);
        return;
      }

      // Prefer the shader transition when available (desktop only)
      const transition = (window as any).sectionTransition;
      if (typeof transition === 'function' && transition(selector)) {
        history.pushState(null, '', selector);
        return;
      }

      const element = document.querySelector(selector);
      if (element) {
        element.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    private copyEmail() {
      const email = 'mahdihabibi31352@gmail.com';
      navigator.clipboard.writeText(email).then(() => {
