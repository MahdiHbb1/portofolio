---
import Base from '../../layouts/Base.astro';
---

<Base title="XSS to Admin Takeover">
  <div class="container" style="padding-block: var(--section-pad);">
    <a href="/#writeups" class="back-link">&larr; Back to writeups</a>
    
    <article class="writeup">
      <header class="writeup__header">
        <p class="label">Web Exploitation · CTF Event 2024</p>
        <h1>XSS to Admin Takeover</h1>
      </header>

      <div class="writeup__content">
        <p><em>Writeup content coming soon...</em></p>
      </div>
    </article>
  </div>
</Base>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .writeup {
    max-width: 68ch;
  }

  .writeup__header {
    margin-bottom: 2rem;
  }

  .writeup__header h1 {
    margin-top: 0.5rem;
  }

  .writeup__content {
    color: var(--fg-muted);
    line-height: 1.75;
  }
</style>
