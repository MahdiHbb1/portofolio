---
const categories = [
  {
    name: 'Security',
    items: ['CTF', 'Web Exploitation', 'Forensics', 'Reverse Engineering', 'Burp Suite', 'Wireshark'],
  },
  {
    name: 'Machine Learning',
    items: ['Python', 'TensorFlow', 'PyTorch', 'CNN', 'scikit-learn', 'OpenCV'],
  },
  {
    name: 'Web Development',
    items: ['Astro', 'JavaScript', 'TypeScript', 'HTML/CSS', 'Node.js', 'REST API'],
  },
  {
    name: 'Tools & Infra',
    items: ['Git', 'Linux', 'Docker', 'VS Code', 'Arduino', 'Raspberry Pi'],
  },
];
---

<section class="section skills" id="skills">
  <div class="container">

    <header class="skills__header reveal">
      <p class="label">Expertise</p>
      <h2>Skills</h2>
    </header>

    <div class="skills__grid">
      {categories.map((cat, i) => (
        <div class="skills__cat reveal" style={`--delay: ${i * 80}ms`}>
          <h3 class="skills__cat-name">{cat.name}</h3>
          <ul class="skills__list" role="list">
            {cat.items.map(item => (
              <li class="skills__item">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .skills__header {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .skills__header h2 {
    margin-top: 0.5rem;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .skills__cat {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--bg-raised);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background 180ms ease;
  }

  .skills__cat:hover {
    background: var(--bg-subtle);
  }

  .skills__cat-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .skills__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .skills__item {
    font-size: 0.9rem;
    color: var(--fg-muted);
    padding-left: 0.875rem;
    position: relative;
    transition: color 160ms ease, padding-left 160ms ease;
  }

  /* Bullet tembaga kecil */
  .skills__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 50%;
    opacity: 0.5;
    transition: opacity 160ms ease;
  }

  .skills__cat:hover .skills__item {
    color: var(--fg);
  }

  .skills__cat:hover .skills__item::before {
    opacity: 1;
  }
</style>
