---
// OrbitGallery — scene 3D orbit gallery
// State 1 (<=640px) : list vertikal sederhana (fallback fungsional)
// State 2 (641–900px): Three.js full, kamera z=10
// State 3 (>900px)   : Three.js full, kamera z=7
import PanelDetailModal from './PanelDetailModal.astro';
---

<div class="orbit-root" aria-label="Interactive 3D project gallery">

  <!-- State 1: list fallback mobile -->
  <nav class="mobile-list" aria-label="Featured projects">
    <p class="mobile-list__label">Featured Projects</p>
    <ul>
      <li>
        <a href="/projects/sigap-mbg" class="mobile-list__item">
          <span class="mobile-list__name">SIGAP MBG</span>
          <span class="mobile-list__cat">hardware + software</span>
        </a>
      </li>
      <li>
        <a href="/projects/fraudlens" class="mobile-list__item">
          <span class="mobile-list__name">FraudLens</span>
          <span class="mobile-list__cat">fraud detection</span>
        </a>
      </li>
      <li>
        <a href="/projects/fabric-cnn" class="mobile-list__item">
          <span class="mobile-list__name">Fabric Defect CNN</span>
          <span class="mobile-list__cat">computer vision</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- State 2 & 3: Three.js canvas -->
  <canvas class="orbit-canvas" aria-hidden="true"></canvas>

  <button class="orbit-reset" aria-label="Reset camera position" title="Reset view">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M2 8a6 6 0 1 1 1.5 3.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <polyline points="2,12 2,8 6,8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <noscript>
    <p class="orbit-noscript">Enable JavaScript to view the interactive gallery.</p>
  </noscript>
</div>

<PanelDetailModal />

<style>
  /* ─── Root ──────────────────────────────────────────────────── */
  .orbit-root {
    position: relative;
    width: 100%;
    height: 100dvh;
    background: #0f0e0d;
    overflow: hidden;
  }

  /* ─── State 1: hide on mobile (<=640px) ─────────────────────── */
  .mobile-list {
    display: none;
  }

  @media (max-width: 640px) {
    .orbit-root {
      display: block;
      height: 0;
      min-height: 0;
      overflow: hidden;
    }

    .orbit-canvas,
    .orbit-reset,
    .mobile-list {
      display: none;
    }
  }

  .mobile-list__label {
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(160, 120, 80, 0.6);
    margin-bottom: 0.75rem;
  }

  .mobile-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-list__item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    min-height: 48px;
    border: 1px solid rgba(232, 224, 212, 0.08);
    border-radius: 4px;
    text-decoration: none;
    transition: background 150ms ease, border-color 150ms ease;
  }

  .mobile-list__item:hover,
  .mobile-list__item:focus-visible {
    background: rgba(160, 120, 80, 0.07);
    border-color: rgba(160, 120, 80, 0.25);
    outline: none;
  }

  .mobile-list__item:active {
    background: rgba(160, 120, 80, 0.12);
  }

  .mobile-list__name {
    font-family: monospace;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(232, 224, 212, 0.9);
    flex-shrink: 0;
  }

  .mobile-list__cat {
    font-family: monospace;
    font-size: 0.7rem;
    color: rgba(160, 120, 80, 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ─── State 2 & 3: Three.js canvas ─────────────────────────── */
  .orbit-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }

  .orbit-canvas:active {
    cursor: grabbing;
  }

  /* ─── Tombol reset ──────────────────────────────────────────── */
  .orbit-reset {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(232, 224, 212, 0.06);
    border: 1px solid rgba(232, 224, 212, 0.14);
    border-radius: 6px;
    color: rgba(232, 224, 212, 0.55);
    cursor: pointer;
    padding: 0;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .orbit-reset:hover {
    background: rgba(160, 120, 80, 0.12);
    border-color: rgba(160, 120, 80, 0.35);
    color: rgba(232, 224, 212, 0.9);
    box-shadow: 0 0 16px rgba(160, 120, 80, 0.5);
  }

  .orbit-reset:focus-visible {
    outline: 2px solid rgba(160, 120, 80, 0.6);
    outline-offset: 2px;
    box-shadow: 0 0 20px rgba(160, 120, 80, 0.6);
  }

  /* ─── Noscript ──────────────────────────────────────────────── */
  .orbit-noscript {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e8e0d4;
    font-family: sans-serif;
    font-size: 0.875rem;
    opacity: 0.5;
  }
</style>

<script type="module">
  let isInitialized = false;
  let currentCleanup: (() => void) | null = null;
  let isFirstLoad = true;

  async function initOrbitGallery() {
    if (window.matchMedia('(max-width: 640px)').matches) {
      isInitialized = false;
      return;
    }

    const root     = document.querySelector('.orbit-root');
    const canvas   = root?.querySelector('.orbit-canvas');
    const resetBtn = root?.querySelector('.orbit-reset');

    if (!(canvas instanceof HTMLCanvasElement) || !canvas.isConnected) {
      isInitialized = false;
      return;
    }

    if (isInitialized) return;

    // Dynamic import — code-split Three.js + orbit modules (566KB)
    // Hanya load saat viewport >640px
    const [
      { createScene, startLoop },
      { createBlob },
      { createNebulae },
      { createStarfield },
      { createPanels },
      { createLines },
      { createControls },
      { createAsteroids },
      { createShootingStars },
    ] = await Promise.all([
      import('./orbit/scene.ts'),
      import('./orbit/blob.ts'),
      import('./orbit/nebula.ts'),
      import('./orbit/starfield.ts'),
      import('./orbit/panels.ts'),
      import('./orbit/lines.ts'),
      import('./orbit/controls.ts'),
      import('./orbit/asteroids.ts'),
      import('./orbit/shooting-stars.ts'),
    ]);

    // State 2: 641–900px → kamera z=10 (zoom out)
    // State 3: >900px    → kamera z=7
    const isState2 = window.matchMedia('(max-width: 900px)').matches;
    const ctx = createScene(canvas, isState2 ? 10 : 7);

    const nebulae  = createNebulae(ctx);
    const starfield = createStarfield(ctx);
    const blob     = createBlob(ctx);
    const asteroids = createAsteroids(ctx);
    const shootingStars = createShootingStars(ctx);
    const panels   = createPanels(ctx);
    const lines    = createLines(ctx, panels);
    const controls = createControls(ctx, resetBtn ?? null, panels);

    // Adaptive zoom saat viewport di-resize melewati breakpoint State 2↔3
    const mq = window.matchMedia('(max-width: 900px)');
    function onBreakpointChange(e) {
      ctx.camera.position.setZ(e.matches ? 10 : 7);
      controls.tick();
    }
    mq.addEventListener('change', onBreakpointChange);

    const stopLoop = startLoop(ctx, (elapsed, _delta) => {
      nebulae.tick(elapsed);
      starfield.tick(elapsed);
      blob.tick(elapsed);
      asteroids.tick(elapsed);
      shootingStars.tick(elapsed);
      panels.tick(elapsed, ctx.camera);
      lines.tick(elapsed);
      controls.tick();
    });

    const cleanup = () => {
      mq.removeEventListener('change', onBreakpointChange);
      stopLoop();
      controls.dispose();
      lines.dispose();
      panels.dispose();
      shootingStars.dispose();
      asteroids.dispose();
      blob.dispose();
      starfield.dispose();
      nebulae.dispose();
      ctx.dispose();
      isInitialized = false;
    };

    currentCleanup = cleanup;
    isInitialized = true;

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  initOrbitGallery();
  
  document.addEventListener('astro:page-load', () => {
    if (isFirstLoad) {
      isFirstLoad = false;
      return;
    }
    initOrbitGallery();
  });
</script>
</script>
