---
import { projects } from '../../data/projects.ts';
---

<section class="section projects" id="projects">
  <div class="container">

    <header class="projects__header reveal">
      <p class="label" data-i18n="projects.label">Karya</p>
      <h2 data-i18n="projects.heading">Projects</h2>
    </header>

    <ul class="projects__grid reveal" style="--delay: 120ms" role="list">
      {projects.map((p) => (
        <li class={`project-card ${p.featured ? 'project-card--featured' : ''}`}>
          <a
            href={`/projects/${p.id}`}
            class="project-card__link"
            style={`--placeholder-gradient: ${p.gradient}`}
          >
            <div class="project-card__top">
              <span class="project-card__year label">{p.year}</span>
              <span
                class="project-card__cat"
                data-i18n-id={p.category.id}
                data-i18n-en={p.category.en}
              >{p.category.id}</span>
            </div>

            <h3 class="project-card__name">{p.name}</h3>
            <p class="project-card__desc" data-i18n={`projects.items.${p.id}.desc`}>{p.desc.id}</p>

            <ul class="project-card__tags" aria-label="Tags">
              {p.tags.map((tag) => <li>{tag}</li>)}
            </ul>

            <span class="project-card__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .projects__header {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .projects__header h2 {
    margin-top: 0.5rem;
  }

  .projects__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .project-card {
    grid-column: span 6;
  }

  .project-card--featured {
    grid-column: span 12;
  }

  @media (max-width: 640px) {
    .project-card {
      grid-column: span 12;
    }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .project-card {
      grid-column: span 6;
    }

    .project-card--featured {
      grid-column: span 12;
    }
  }

  @media (min-width: 901px) {
    .project-card {
      grid-column: span 6;
    }

    .project-card--featured {
      grid-column: span 12;
    }

    .project-card:nth-child(4) {
      grid-column: span 7;
    }
    .project-card:nth-child(5) {
      grid-column: span 5;
    }
  }

  .project-card__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    height: 100%;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: all 240ms var(--ease-smooth);
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  .project-card__link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--placeholder-gradient, linear-gradient(135deg, rgba(160, 120, 80, 0.05), transparent));
    opacity: 0.6;
    transition: opacity 240ms ease;
  }

  .project-card__link:hover {
    background: var(--bg-subtle);
    border-color: var(--border-accent);
    transform: translateY(-4px) rotateX(2deg);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4), 0 0 24px rgba(160, 120, 80, 0.15);
  }

  .project-card__link:hover::before {
    opacity: 1;
  }

  .project-card__link:active {
    transform: translateY(-2px) rotateX(1deg);
  }

  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-card__cat {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-faint);
    letter-spacing: 0.06em;
  }

  .project-card__name {
    font-size: 1.1rem;
    color: var(--fg);
    font-weight: 600;
    position: relative;
    z-index: 1;
  }

  .project-card--featured .project-card__name {
    font-size: clamp(1.35rem, 3vw, 1.6rem);
    font-weight: 700;
  }

  .project-card__desc {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    flex: 1;
    max-width: none;
    position: relative;
    z-index: 1;
  }

  .project-card--featured .project-card__desc {
    font-size: 0.95rem;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin-top: auto;
  }

  .project-card__tags li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    background: var(--accent-dim);
    color: var(--accent-bright);
    border-radius: 2px;
  }

  .project-card__arrow {
    position: absolute;
    bottom: clamp(1.25rem, 3vw, 1.75rem);
    right: clamp(1.25rem, 3vw, 1.75rem);
    font-size: 1rem;
    color: var(--fg-faint);
    transition: all 220ms var(--ease-spring);
    transform-origin: center;
  }

  .project-card__link:hover .project-card__arrow {
    color: var(--accent-bright);
    transform: translateX(4px) scale(1.1);
  }
</style>
