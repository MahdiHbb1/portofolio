---
import { t } from '../../data/content';

const projects = [
  {
    id: 'sigapMbg',
    name: 'SIGAP MBG',
    category: 'Hardware + Software',
    tags: ['PKM-KC', 'ML', 'IoT'],
    desc: 'Sistem monitoring berbasis ML untuk program makan bergizi gratis nasional. Mendapat pendanaan PKM-KC nasional.',
    year: '2025',
    gradient: 'linear-gradient(135deg, rgba(232, 224, 212, 0.08), rgba(160, 120, 80, 0.12))',
    featured: true,
  },
  {
    id: 'fraudlens',
    name: 'FraudLens',
    category: 'Fraud Detection',
    tags: ['security', 'ML'],
    desc: 'Placeholder — tambahkan deskripsi project.',
    year: '2024',
    gradient: 'linear-gradient(135deg, rgba(255, 120, 60, 0.08), rgba(139, 115, 85, 0.12))',
    featured: false,
  },
  {
    id: 'fabricCnn',
    name: 'Fabric Defect CNN',
    category: 'Computer Vision',
    tags: ['deep learning', 'skripsi'],
    desc: 'Placeholder — tambahkan deskripsi project.',
    year: '2024',
    gradient: 'linear-gradient(135deg, rgba(100, 150, 200, 0.08), rgba(107, 93, 79, 0.12))',
    featured: false,
  },
  {
    id: 'legalin',
    name: 'LegalIn',
    category: 'AI Legal Assistant',
    tags: ['AI', 'web'],
    desc: 'Placeholder — tambahkan deskripsi project.',
    year: '2024',
    gradient: 'linear-gradient(135deg, rgba(120, 180, 120, 0.08), rgba(107, 93, 79, 0.12))',
    featured: false,
  },
  {
    id: 'buktitagih',
    name: 'BuktiTagih AI',
    category: 'Hackathon',
    tags: ['AI', 'hackathon'],
    desc: 'Placeholder — tambahkan deskripsi project.',
    year: '2024',
    gradient: 'linear-gradient(135deg, rgba(160, 100, 200, 0.08), rgba(107, 93, 79, 0.12))',
    featured: false,
  },
  {
    id: 'ctfItsecdevx26',
    name: 'CTF itsecdevx26',
    category: 'Security Challenge',
    tags: ['CTF', 'security'],
    desc: 'Placeholder — tambahkan deskripsi challenge.',
    year: '2024',
    gradient: 'linear-gradient(135deg, rgba(200, 80, 80, 0.08), rgba(139, 115, 85, 0.12))',
    featured: false,
  },
  {
    id: 'ctfWriteups',
    name: 'CTF Writeups',
    category: 'Writeups',
    tags: ['CTF', 'writeups'],
    desc: 'Kumpulan writeup dari berbagai kompetisi CTF.',
    year: '2024–2025',
    gradient: 'linear-gradient(135deg, rgba(255, 180, 100, 0.08), rgba(139, 115, 85, 0.12))',
    featured: false,
  },
];
---

<section class="section projects" id="projects">
  <div class="container">

    <header class="projects__header reveal">
      <p class="label" data-i18n="projects.label">Karya</p>
      <h2 data-i18n="projects.heading">Projects</h2>
    </header>

    <ul class="projects__grid reveal" style="--delay: 120ms" role="list">
      {projects.map((p, i) => (
        <li class={`project-card ${p.featured ? 'project-card--featured' : ''}`}>
          <a 
            href={`/projects/${p.id}`} 
            class="project-card__link"
            style={`--placeholder-gradient: ${p.gradient}`}
          >
            <div class="project-card__top">
              <span class="project-card__year label">{p.year}</span>
              <span class="project-card__cat">{p.category}</span>
            </div>

            <h3 class="project-card__name">{p.name}</h3>
            <p class="project-card__desc" data-i18n={`projects.items.${p.id}.desc`}>{p.desc}</p>

            <ul class="project-card__tags" aria-label="Tags">
              {p.tags.map(t => <li>{t}</li>)}
            </ul>

            <span class="project-card__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .projects__header {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .projects__header h2 {
    margin-top: 0.5rem;
  }

  .projects__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .project-card {
    grid-column: span 6;
  }

  .project-card--featured {
    grid-column: span 12;
  }

  @media (max-width: 640px) {
    .project-card {
      grid-column: span 12;
    }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .project-card {
      grid-column: span 6;
    }
    
    .project-card--featured {
      grid-column: span 12;
    }
  }

  @media (min-width: 901px) {
    .project-card {
      grid-column: span 6;
    }

    .project-card--featured {
      grid-column: span 12;
    }

    .project-card:nth-child(4) {
      grid-column: span 7;
    }
    .project-card:nth-child(5) {
      grid-column: span 5;
    }
  }

  .project-card__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    height: 100%;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: all 240ms cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .project-card__link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--placeholder-gradient, linear-gradient(135deg, rgba(160, 120, 80, 0.05), transparent));
    opacity: 0.6;
    transition: opacity 240ms ease;
  }

  .project-card__link:hover {
    background: var(--bg-subtle);
    border-color: var(--border-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .project-card__link:hover::before {
    opacity: 1;
  }

  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-card__year {
    /* label class sudah handle font/size/color */
  }

  .project-card__cat {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-faint);
    letter-spacing: 0.06em;
  }

  .project-card__name {
    font-size: 1.1rem;
    color: var(--fg);
    font-weight: 600;
    position: relative;
    z-index: 1;
  }

  .project-card--featured .project-card__name {
    font-size: clamp(1.35rem, 3vw, 1.6rem);
    font-weight: 700;
  }

  .project-card__desc {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    flex: 1;
    max-width: none;
    position: relative;
    z-index: 1;
  }

  .project-card--featured .project-card__desc {
    font-size: 0.95rem;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin-top: auto;
  }

  .project-card__tags li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    background: var(--accent-dim);
    color: var(--accent);
    border-radius: 2px;
  }

  .project-card__arrow {
    position: absolute;
    bottom: clamp(1.25rem, 3vw, 1.75rem);
    right: clamp(1.25rem, 3vw, 1.75rem);
    font-size: 1rem;
    color: var(--fg-faint);
    transition: color 180ms ease, transform 180ms ease;
  }

  .project-card__link:hover .project-card__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
