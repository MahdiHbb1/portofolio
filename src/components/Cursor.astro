---
// Enhanced Cursor dengan magnetic effect
---

<div class="cursor" id="cursor" aria-hidden="true">
  <div class="cursor__dot"></div>
  <div class="cursor__ring"></div>
  <div class="cursor__trail"></div>
</div>

<style>
  /* Sembunyikan cursor asli - hanya saat body punya custom cursor */
  @media (pointer: fine) {
    body.has-custom-cursor,
    body.has-custom-cursor * { cursor: none; }
  }

  .cursor {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  @media (pointer: fine) {
    .cursor { display: block; }
  }

  .cursor__dot {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--fg);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 180ms ease, height 180ms ease, background 180ms ease;
  }

  .cursor__ring {
    position: absolute;
    width: 32px;
    height: 32px;
    border: 1.5px solid rgba(232, 224, 212, 0.35);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 220ms var(--ease-smooth),
                height 220ms var(--ease-smooth),
                border-color 220ms ease;
  }

  .cursor__trail {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 1px solid rgba(160, 120, 80, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .cursor.is-hovering .cursor__dot {
    width: 10px;
    height: 10px;
    background: var(--accent);
  }

  .cursor.is-hovering .cursor__ring {
    width: 56px;
    height: 56px;
    border-color: rgba(160, 120, 80, 0.6);
  }

  .cursor.is-hovering .cursor__trail {
    opacity: 1;
    width: 40px;
    height: 40px;
  }

  .cursor.is-clicking .cursor__dot {
    width: 4px;
    height: 4px;
  }

  .cursor.is-clicking .cursor__ring {
    width: 20px;
    height: 20px;
    border-color: var(--accent);
  }

  .cursor.is-magnetic .cursor__ring {
    width: 64px;
    height: 64px;
    border-color: var(--accent);
  }
</style>

<script>
  function initCursor() {
    if (!window.matchMedia('(pointer: fine)').matches) {
      document.body.classList.remove('has-custom-cursor');
      return;
    }

    const cursorFound = document.getElementById('cursor');
    if (!cursorFound) {
      document.body.classList.remove('has-custom-cursor');
      return;
    }
    if (cursorFound.dataset.initialized === 'true') return;
    cursorFound.dataset.initialized = 'true';
    const cursor: HTMLElement = cursorFound;

    document.body.classList.add('has-custom-cursor');

    const ring = cursor.querySelector('.cursor__ring') as HTMLElement;
    const trail = cursor.querySelector('.cursor__trail') as HTMLElement;
    
    let mouseX = 0, mouseY = 0;
    let ringX = 0, ringY = 0;
    let trailX = 0, trailY = 0;
    let rafId: number;

    // Magnetic elements
    const magneticSelector = '.btn, .project-card__link, .achievement-card, .skills__cat';

    function loop() {
      // Smooth follow for ring
      ringX += (mouseX - ringX) * 0.15;
      ringY += (mouseY - ringY) * 0.15;

      // Even smoother for trail
      trailX += (mouseX - trailX) * 0.08;
      trailY += (mouseY - trailY) * 0.08;

      cursor.style.transform = `translate(${mouseX}px, ${mouseY}px)`;
      
      if (ring) {
        ring.style.transform = `translate(calc(${ringX - mouseX}px - 50%), calc(${ringY - mouseY}px - 50%))`;
      }

      if (trail) {
        trail.style.transform = `translate(calc(${trailX - mouseX}px - 50%), calc(${trailY - mouseY}px - 50%))`;
      }

      rafId = requestAnimationFrame(loop);
    }
    loop();

    const mousemoveHandler = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      if (cursor.style.opacity !== '1') {
        cursor.style.opacity = '1';
      }

      // Magnetic effect
      const hoveredMagnetic = (e.target as Element)?.closest(magneticSelector);
      if (hoveredMagnetic) {
        const rect = hoveredMagnetic.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const distance = Math.sqrt(Math.pow(e.clientX - centerX, 2) + Math.pow(e.clientY - centerY, 2));
        
        if (distance < 100) {
          const pullStrength = Math.max(0, 1 - distance / 100);
          mouseX += (centerX - e.clientX) * pullStrength * 0.3;
          mouseY += (centerY - e.clientY) * pullStrength * 0.3;
          cursor.classList.add('is-magnetic');
        } else {
          cursor.classList.remove('is-magnetic');
        }
      } else {
        cursor.classList.remove('is-magnetic');
      }
    };

    const sel = 'a, button, [role="button"], canvas, input, select, textarea, label[for]';
    
    const mouseoverHandler = (e: Event) => {
      if ((e.target as Element)?.closest(sel)) {
        cursor.classList.add('is-hovering');
      }
    };

    const mouseoutHandler = (e: Event) => {
      if ((e.target as Element)?.closest(sel)) {
        cursor.classList.remove('is-hovering');
      }
    };

    const mousedownHandler = () => cursor.classList.add('is-clicking');
    const mouseupHandler = () => cursor.classList.remove('is-clicking');
    const mouseleaveHandler = () => {
      cursor.style.opacity = '0';
      cursor.classList.remove('is-magnetic');
    };
    const mouseenterHandler = () => cursor.style.opacity = '1';

    document.addEventListener('mousemove', mousemoveHandler);
    document.addEventListener('mouseover', mouseoverHandler);
    document.addEventListener('mouseout', mouseoutHandler);
    document.addEventListener('mousedown', mousedownHandler);
    document.addEventListener('mouseup', mouseupHandler);
    document.addEventListener('mouseleave', mouseleaveHandler);
    document.addEventListener('mouseenter', mouseenterHandler);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(rafId);
      document.body.classList.remove('has-custom-cursor');
      document.removeEventListener('mousemove', mousemoveHandler);
      document.removeEventListener('mouseover', mouseoverHandler);
      document.removeEventListener('mouseout', mouseoutHandler);
      document.removeEventListener('mousedown', mousedownHandler);
      document.removeEventListener('mouseup', mouseupHandler);
      document.removeEventListener('mouseleave', mouseleaveHandler);
      document.removeEventListener('mouseenter', mouseenterHandler);
    }, { once: true });
  }

  initCursor();
  document.addEventListener('astro:page-load', initCursor);
</script>
