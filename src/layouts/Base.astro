---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Mahdi Habibi — Portfolio',
  description = 'Mahasiswa Informatika UNNES, IT Security enthusiast, CTF player.',
  ogImage = '/og-default.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter fallback="none" />
  </head>
  <body>
    <Cursor />
    <Navbar />
    <slot />
    <Footer />
    <MobileNav />
  </body>

  <script type="module">
    import { initReveal } from '../scripts/reveal.ts';
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  </script>

  <script type="module">
    import { content } from '../data/content';
    
    const currentLang = (localStorage.getItem('lang') as 'id' | 'en') || 'id';
    const t = content[currentLang];

    // Update lang toggle active state
    function updateLangToggle() {
      document.querySelectorAll('.lang-toggle__option').forEach(el => {
        el.setAttribute('data-active', el.dataset.lang === currentLang ? 'true' : 'false');
      });
    }

    // Replace text content AND data-text for decrypt
    function applyTranslations() {
      // Hero - update both textContent and data-text attribute
      document.querySelectorAll('[data-i18n="hero.name"]').forEach(el => {
        el.textContent = t.hero.name;
        if (el.classList.contains('decrypt')) {
          el.setAttribute('data-text', t.hero.name);
        }
      });
      document.querySelectorAll('[data-i18n="hero.title"]').forEach(el => el.textContent = t.hero.title);
      document.querySelectorAll('[data-i18n="hero.subtitle"]').forEach(el => el.textContent = t.hero.subtitle);
      
      // About
      document.querySelectorAll('[data-i18n="about.label"]').forEach(el => el.textContent = t.about.label);
      document.querySelectorAll('[data-i18n="about.heading"]').forEach(el => el.textContent = t.about.heading);
      document.querySelectorAll('[data-i18n="about.bio1"]').forEach(el => el.textContent = t.about.bio1);
      document.querySelectorAll('[data-i18n="about.bio2"]').forEach(el => el.textContent = t.about.bio2);
      
      // Skills
      document.querySelectorAll('[data-i18n="skills.label"]').forEach(el => el.textContent = t.skills.label);
      document.querySelectorAll('[data-i18n="skills.heading"]').forEach(el => el.textContent = t.skills.heading);
      
      // Achievements
      document.querySelectorAll('[data-i18n="achievements.label"]').forEach(el => el.textContent = t.achievements.label);
      document.querySelectorAll('[data-i18n="achievements.heading"]').forEach(el => el.textContent = t.achievements.heading);
      
      // Achievement items
      Object.keys(t.achievements.items).forEach(key => {
        document.querySelectorAll(`[data-i18n="achievements.items.${key}.desc"]`).forEach(el => {
          el.textContent = t.achievements.items[key].desc;
        });
      });
      
      // Projects
      document.querySelectorAll('[data-i18n="projects.label"]').forEach(el => el.textContent = t.projects.label);
      document.querySelectorAll('[data-i18n="projects.heading"]').forEach(el => el.textContent = t.projects.heading);
      
      // Project items
      Object.keys(t.projects.items).forEach(key => {
        document.querySelectorAll(`[data-i18n="projects.items.${key}.desc"]`).forEach(el => {
          el.textContent = t.projects.items[key].desc;
        });
      });
      
      // Writeups
      document.querySelectorAll('[data-i18n="writeups.label"]').forEach(el => el.textContent = t.writeups.label);
      document.querySelectorAll('[data-i18n="writeups.heading"]').forEach(el => el.textContent = t.writeups.heading);
      
      // Contact
      document.querySelectorAll('[data-i18n="contact.label"]').forEach(el => el.textContent = t.contact.label);
      document.querySelectorAll('[data-i18n="contact.heading"]').forEach(el => el.textContent = t.contact.heading);
      document.querySelectorAll('[data-i18n="contact.subtitle"]').forEach(el => el.textContent = t.contact.subtitle);
    }

    // Toggle lang
    document.getElementById('langToggle')?.addEventListener('click', () => {
      const newLang = currentLang === 'id' ? 'en' : 'id';
      localStorage.setItem('lang', newLang);
      window.location.reload();
    });

    // Init - run BEFORE decrypt animation
    updateLangToggle();
    applyTranslations();
    
    document.addEventListener('astro:page-load', () => {
      updateLangToggle();
      applyTranslations();
    });
  </script>
</html>
