---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Toast from '../components/Toast.astro';
import CommandPalette from '../components/CommandPalette.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import ChatAssistant from '../components/ChatAssistant.astro';
import TerminalEgg from '../components/TerminalEgg.astro';
import fs from 'node:fs';
import { buildPortfolioContext } from '../utils/portfolioContext';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Mahdi Habibi — Portfolio',
  description = 'Mahasiswa Informatika UNNES, IT Security enthusiast, CTF player.',
  ogImage,
} = Astro.props;

const siteURL = new URL(Astro.site ?? Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteURL);

// Prefer a generated per-page OG card (public/og/) when one exists.
const path = Astro.url.pathname;
const ogSlug = path === '/' ? 'home' : path.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogImageURL = new URL(
  ogImage ?? (fs.existsSync(`public/og/${ogSlug}.png`) ? `/og/${ogSlug}.png` : '/og/home.png'),
  siteURL
).href;

const ogImageAlt = `${title} · social preview card`;

// Structured data (schema.org), sourced from the same data as the AI chat.
const portfolio = buildPortfolioContext();
const personId = new URL('/#person', siteURL).href;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: portfolio.about.name,
    jobTitle: portfolio.about.title,
    email: `mailto:${portfolio.about.email}`,
    url: siteURL.href,
    image: new URL('/og/home.png', siteURL).href,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Semarang',
      addressCountry: 'ID',
    },
    sameAs: [portfolio.social.github, portfolio.social.linkedin],
    worksFor: { '@type': 'Organization', name: portfolio.about.organization },
    alumniOf: { '@type': 'CollegeOrUniversity', name: portfolio.education.institution },
    knowsAbout: [
      ...portfolio.skills.security,
      ...portfolio.skills.ml,
      ...portfolio.skills.web,
      ...portfolio.skills.tools,
    ],
  },
];

if (path === '/') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', siteURL).href,
    name: 'Mahdi Habibi — Portfolio',
    url: siteURL.href,
    inLanguage: ['id', 'en'],
    author: { '@id': personId },
  });
}

if (path.startsWith('/projects/') || path.startsWith('/writeups/')) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': path.startsWith('/projects/') ? 'CreativeWork' : 'TechArticle',
    headline: title,
    description,
    url: canonicalURL.href,
    author: { '@id': personId },
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"   content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />
    <meta name="twitter:image:alt"   content={ogImageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter fallback="none" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <LoadingScreen />
    <Cursor />
    <ScrollProgress />
    <Toast />
    <CommandPalette />
    <ChatAssistant />
    <TerminalEgg />
    <Navbar />
    <slot />
    <Footer />
    <MobileNav />
  </body>

  <script>
    import { initReveal } from '../scripts/reveal.ts';
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  </script>

  <script>
    import { initParallax } from '../scripts/parallax.ts';
    initParallax();
    document.addEventListener('astro:page-load', initParallax);
  </script>

  <script>
    import { initSectionTransition } from '../scripts/sectionTransition.ts';
    initSectionTransition();
  </script>

  <script>
    import { initArticle } from '../scripts/article.ts';
    initArticle();
    document.addEventListener('astro:page-load', initArticle);
  </script>

  <script>
    import { content } from '../data/content';

    function getActiveLang(): 'id' | 'en' {
      return localStorage.getItem('lang') === 'en' ? 'en' : 'id';
    }

    // Update lang toggle active state
    function updateLangToggle() {
      const activeLang = getActiveLang();
      document.querySelectorAll<HTMLElement>('.lang-toggle__option').forEach(el => {
        el.setAttribute('data-active', el.dataset.lang === activeLang ? 'true' : 'false');
      });
    }

    // Replace text content AND data-text for decrypt
    function applyTranslations() {
      const activeLang = getActiveLang();
      const t = content[activeLang];
      document.documentElement.lang = activeLang;

      // Hero - update both textContent and data-text attribute
      document.querySelectorAll('[data-i18n="hero.name"]').forEach(el => {
        el.textContent = t.hero.name;
        if (el.classList.contains('decrypt')) {
          el.setAttribute('data-text', t.hero.name);
        }
      });
      document.querySelectorAll('[data-i18n="hero.title"]').forEach(el => el.textContent = t.hero.title);
      document.querySelectorAll('[data-i18n="hero.subtitle"]').forEach(el => el.textContent = t.hero.subtitle);
      document.querySelectorAll('[data-i18n="hero.ctaWork"]').forEach(el => el.textContent = t.hero.ctaWork);
      document.querySelectorAll('[data-i18n="hero.ctaContact"]').forEach(el => el.textContent = t.hero.ctaContact);

      // About
      document.querySelectorAll('[data-i18n="about.label"]').forEach(el => el.textContent = t.about.label);
      document.querySelectorAll('[data-i18n="about.heading"]').forEach(el => el.textContent = t.about.heading);
      document.querySelectorAll('[data-i18n="about.bio1"]').forEach(el => el.textContent = t.about.bio1);
      document.querySelectorAll('[data-i18n="about.bio2"]').forEach(el => el.textContent = t.about.bio2);

      // Skills
      document.querySelectorAll('[data-i18n="skills.label"]').forEach(el => el.textContent = t.skills.label);
      document.querySelectorAll('[data-i18n="skills.heading"]').forEach(el => el.textContent = t.skills.heading);

      // Achievements
      document.querySelectorAll('[data-i18n="achievements.label"]').forEach(el => el.textContent = t.achievements.label);
      document.querySelectorAll('[data-i18n="achievements.heading"]').forEach(el => el.textContent = t.achievements.heading);
      document.querySelectorAll('[data-i18n="achievements.certificate"]').forEach(el => el.textContent = t.achievements.certificate);

      // Achievement items
      Object.entries(t.achievements.items).forEach(([key, item]) => {
        document.querySelectorAll(`[data-i18n="achievements.items.${key}.desc"]`).forEach(el => {
          el.textContent = item.desc;
        });
      });

      // Projects
      document.querySelectorAll('[data-i18n="projects.label"]').forEach(el => el.textContent = t.projects.label);
      document.querySelectorAll('[data-i18n="projects.heading"]').forEach(el => el.textContent = t.projects.heading);

      // Project items
      Object.entries(t.projects.items).forEach(([key, item]) => {
        document.querySelectorAll(`[data-i18n="projects.items.${key}.desc"]`).forEach(el => {
          el.textContent = item.desc;
        });
      });

      // Project detail layout chrome
      document.querySelectorAll('[data-i18n="project.back"]').forEach(el => el.textContent = t.project.back);
      document.querySelectorAll('[data-i18n="project.screenshotsLabel"]').forEach(el => el.textContent = t.project.screenshotsLabel);
      document.querySelectorAll('[data-i18n="project.screenshotsEmptyTitle"]').forEach(el => el.textContent = t.project.screenshotsEmptyTitle);
      document.querySelectorAll('[data-i18n="project.screenshotsEmptyHint"]').forEach(el => el.textContent = t.project.screenshotsEmptyHint);

      // Inline bilingual data attributes (categories, screenshot captions/alt)
      document.querySelectorAll<HTMLElement>('[data-i18n-id]').forEach(el => {
        const localized = activeLang === 'en' ? el.dataset.i18nEn : el.dataset.i18nId;
        if (localized) el.textContent = localized;
      });
      document.querySelectorAll<HTMLImageElement>('[data-i18n-alt-id]').forEach(el => {
        const localized = activeLang === 'en' ? el.dataset.i18nAltEn : el.dataset.i18nAltId;
        if (localized) el.setAttribute('alt', localized);
      });

      // Writeups
      document.querySelectorAll('[data-i18n="writeups.label"]').forEach(el => el.textContent = t.writeups.label);
      document.querySelectorAll('[data-i18n="writeups.heading"]').forEach(el => el.textContent = t.writeups.heading);

      // Terminal playground
      document.querySelectorAll('[data-i18n="terminal.label"]').forEach(el => el.textContent = t.terminal.label);
      document.querySelectorAll('[data-i18n="terminal.heading"]').forEach(el => el.textContent = t.terminal.heading);
      document.querySelectorAll('[data-i18n="terminal.hint"]').forEach(el => el.textContent = t.terminal.hint);

      // Contact
      document.querySelectorAll('[data-i18n="contact.label"]').forEach(el => el.textContent = t.contact.label);
      document.querySelectorAll('[data-i18n="contact.heading"]').forEach(el => el.textContent = t.contact.heading);
      document.querySelectorAll('[data-i18n="contact.subtitle"]').forEach(el => el.textContent = t.contact.subtitle);
    }

    // Toggle lang (delegated so it survives client-side navigation)
    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      if (!target?.closest('#langToggle')) return;
      const newLang = getActiveLang() === 'id' ? 'en' : 'id';
      localStorage.setItem('lang', newLang);
      window.location.reload();
    });

    // Init - run BEFORE decrypt animation
    updateLangToggle();
    applyTranslations();

    document.addEventListener('astro:page-load', () => {
      updateLangToggle();
      applyTranslations();
    });
  </script>
</html>
