---
import ParticleField from '../ParticleField.astro';
---

<section class="hero" id="hero" aria-label="Hero">
  <div class="hero__bg">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__glow" aria-hidden="true"></div>
    <ParticleField />
  </div>

  <div class="hero__content container">
    <div class="hero__text">
      <h1 class="hero__name">
        <span class="decrypt" data-i18n="hero.name" data-text="Mahdi Habibi">Mahdi Habibi</span>
      </h1>
      <p class="hero__title" data-i18n="hero.title">Security & ML Engineer</p>
      <p class="hero__sub" data-i18n="hero.subtitle">
        Informatika UNNES · CTF · PKM-KC
      </p>

      <div class="hero__cta">
        <a href="#gallery" class="btn btn--primary" data-hero-work-cta data-i18n="hero.ctaWork">Lihat Karya</a>
        <a href="#contact" class="btn btn--secondary" data-i18n="hero.ctaContact">Hubungi Saya</a>
      </div>
    </div>

    <a href="#about" class="hero__scroll" aria-label="Scroll to about">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 4v12M4 10l6 6 6-6" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(232, 224, 212, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232, 224, 212, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 0%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 0%, transparent 80%);
    animation: grid-flow 20s linear infinite;
  }

  .hero__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(160, 120, 80, 0.15) 0%, transparent 70%);
    filter: blur(60px);
    opacity: 0.6;
    animation: glow-pulse 4s ease-in-out infinite;
  }

  @keyframes grid-flow {
    0% { transform: translateY(0); }
    100% { transform: translateY(50px); }
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 0.7; transform: translate(-50%, -50%) scale(1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__grid,
    .hero__glow {
      animation: none;
    }
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .hero__text {
    max-width: 48rem;
  }

  .hero__name {
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--fg);
    margin-bottom: 1rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .hero__title {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
    font-weight: 400;
  }

  .hero__sub {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
    margin-bottom: 2.5rem;
  }

  .hero__cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    border-radius: 6px;
    transition: all 220ms cubic-bezier(0.4, 0, 0.2, 1);
    min-height: 48px;
    text-decoration: none;
  }

  .btn--primary {
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
  }

  .btn--primary:hover {
    background: rgba(160, 120, 80, 0.9);
    box-shadow: 0 8px 24px rgba(160, 120, 80, 0.3);
    transform: translateY(-2px);
  }

  .btn--secondary {
    background: var(--bg-raised);
    color: var(--fg);
    border: 1px solid var(--border);
  }

  .btn--secondary:hover {
    background: var(--bg-subtle);
    border-color: var(--border-accent);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    transform: translateY(-2px);
  }

  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border);
    border-radius: 50%;
    transition: all 200ms ease;
    animation: bob 2.4s ease-in-out infinite;
  }

  .hero__scroll:hover {
    color: var(--fg);
    border-color: var(--border-accent);
    box-shadow: 0 0 16px rgba(160, 120, 80, 0.5);
  }

  .hero__scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll { animation: none; }
  }

  .decrypt {
    display: inline-block;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 85dvh;
    }

    .hero__name {
      font-size: clamp(2.5rem, 10vw, 3rem);
    }

    .hero__cta {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }

    .btn {
      width: 100%;
    }
  }
</style>

<script>
  function syncHeroWorkTarget() {
    const workLink = document.querySelector<HTMLAnchorElement>('[data-hero-work-cta]');
    if (!workLink) return;
    const isPhone = window.matchMedia('(max-width: 640px)').matches;
    workLink.setAttribute('href', isPhone ? '#projects' : '#gallery');
  }

  function initHeroDecrypt() {
    const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&';
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.decrypt').forEach((el) => {
      if (el.dataset.decryptInit === 'true') return;
      el.dataset.decryptInit = 'true';

      const target = el.dataset.text || el.textContent || '';
      const delay = parseInt(getComputedStyle(el).getPropertyValue('--delay') || '0', 10) || 0;

      if (prefersReduced) {
        el.textContent = target;
        return;
      }

      let resolved = 0;
      let frame = 0;
      const SCRAMBLE_LEAD = 18;
      const RESOLVE_EVERY = 4;

      function scramble() {
        let display = '';
        for (let i = 0; i < target.length; i++) {
          if (target[i] === ' ') {
            display += ' ';
            continue;
          }
          display += i < resolved ? target[i] : CHARS[Math.floor(Math.random() * CHARS.length)];
        }
        el.textContent = display;
        frame++;
        if (frame > SCRAMBLE_LEAD && frame % RESOLVE_EVERY === 0) {
          resolved++;
        }
        if (resolved <= target.length) {
          requestAnimationFrame(scramble);
        } else {
          el.textContent = target;
        }
      }

      window.setTimeout(() => requestAnimationFrame(scramble), delay);
    });
  }

  const mq = window.matchMedia('(max-width: 640px)');
  mq.addEventListener('change', syncHeroWorkTarget);

  function initHero() {
    syncHeroWorkTarget();
    initHeroDecrypt();
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
