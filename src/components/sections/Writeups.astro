---
import { t } from '../../data/content';

const writeups = [
  {
    id: 'itsecdevx26-web',
    title: 'SQL Injection via Login Bypass',
    event: 'itsecdevx26 CTF',
    year: '2024',
    category: 'Web Exploitation',
    tags: ['SQLi', 'auth bypass'],
  },
  {
    id: 'itsecdevx26-forensics',
    title: 'Memory Dump Analysis',
    event: 'itsecdevx26 CTF',
    year: '2024',
    category: 'Forensics',
    tags: ['volatility', 'memory'],
  },
  {
    id: 'placeholder-xss',
    title: 'XSS to Admin Takeover',
    event: 'CTF Event Placeholder',
    year: '2024',
    category: 'Web Exploitation',
    tags: ['XSS', 'session'],
  },
  {
    id: 'placeholder-crypto',
    title: 'RSA Key Recovery',
    event: 'CTF Event Placeholder',
    year: '2025',
    category: 'Cryptography',
    tags: ['RSA', 'crypto'],
  },
];
---

<section class="section writeups" id="writeups">
  <div class="container">

    <header class="writeups__header reveal">
      <p class="label" data-i18n="writeups.label">Keamanan</p>
      <h2 data-i18n="writeups.heading">CTF Writeups</h2>
    </header>

    <div class="writeups__timeline">
      {writeups.map((w, i) => (
        <article class="writeup-card reveal" style={`--delay: ${i * 100}ms`}>
          <div class="writeup-card__year-marker">
            <span class="writeup-card__year">{w.year}</span>
          </div>
          
          <a href={`/writeups/${w.id}`} class="writeup-card__link">
            <div class="writeup-card__content">
              <div class="writeup-card__header">
                <span class="writeup-card__event label">{w.event}</span>
                <span class="writeup-card__category">{w.category}</span>
              </div>

              <h3 class="writeup-card__title">{w.title}</h3>

              <ul class="writeup-card__tags" aria-label="Tags">
                {w.tags.map(t => <li>{t}</li>)}
              </ul>

              <span class="writeup-card__arrow" aria-hidden="true">→</span>
            </div>
          </a>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .writeups__header {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .writeups__header h2 {
    margin-top: 0.5rem;
  }

  .writeups__timeline {
    position: relative;
    max-width: 56rem;
    margin: 0 auto;
    padding-left: 2rem;
  }

  .writeups__timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, 
      transparent 0%, 
      var(--border-accent) 10%, 
      var(--border-accent) 90%, 
      transparent 100%
    );
  }

  .writeup-card {
    position: relative;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .writeup-card:last-child {
    margin-bottom: 0;
  }

  .writeup-card__year-marker {
    position: absolute;
    left: -2rem;
    top: 1.5rem;
    transform: translateX(-50%);
    z-index: 2;
  }

  .writeup-card__year {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: var(--bg-raised);
    border: 2px solid var(--border-accent);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent);
  }

  .writeup-card__link {
    display: block;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: all 240ms cubic-bezier(0.4, 0, 0.2, 1);
    margin-left: 1.5rem;
  }

  .writeup-card__link:hover {
    background: var(--bg-subtle);
    border-color: var(--border-accent);
    transform: translateX(8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .writeup-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
  }

  .writeup-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .writeup-card__event {
    /* label class styling */
  }

  .writeup-card__category {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .writeup-card__title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.4;
  }

  .writeup-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .writeup-card__tags li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.25rem 0.55rem;
    background: var(--accent-dim);
    color: var(--accent);
    border-radius: 3px;
  }

  .writeup-card__arrow {
    position: absolute;
    bottom: 0;
    right: 0;
    font-size: 1rem;
    color: var(--fg-faint);
    transition: color 180ms ease, transform 180ms ease;
  }

  .writeup-card__link:hover .writeup-card__arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .writeups__timeline {
      padding-left: 1.5rem;
    }

    .writeup-card__year-marker {
      left: -1.5rem;
    }

    .writeup-card__year {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 0.65rem;
    }

    .writeup-card__link {
      margin-left: 1rem;
    }

    .writeup-card__link:hover {
      transform: translateX(0) translateY(-2px);
    }
  }
</style>
