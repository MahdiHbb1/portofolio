---

<nav class="mobile-nav" aria-label="Mobile navigation">
  <a href="/#about" class="mobile-nav__item">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M10 11a3 3 0 100-6 3 3 0 000 6zM4 18c0-3.314 2.686-6 6-6s6 2.686 6 6" 
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <span>About</span>
  </a>

  <a href="/#gallery" class="mobile-nav__item mobile-nav__item--gallery">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/>
      <path d="M10 3v2M10 15v2M3 10h2M15 10h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <span>Gallery</span>
  </a>

  <a href="/#writeups" class="mobile-nav__item mobile-nav__item--writeups">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M10 2.5l6.5 2.7v4.5c0 3.7-2.8 7-6.5 7.8-3.7-.8-6.5-4.1-6.5-7.8V5.2L10 2.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
    <span>Writeups</span>
  </a>

  <a href="/#projects" class="mobile-nav__item">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="11" y="3" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="3" y="11" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="11" y="11" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
    </svg>
    <span>Projects</span>
  </a>

  <a href="/#terminal" class="mobile-nav__item">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M5.5 8.5l2.5 2.5-2.5 2.5M10.5 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>Terminal</span>
  </a>

  <a href="/#contact" class="mobile-nav__item">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M2 7l8 5 8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <span>Contact</span>
  </a>
</nav>

<style>
  .mobile-nav {
    display: none;
  }

  @media (max-width: 900px) {
    .mobile-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-around;
      align-items: center;
      background: rgba(15, 14, 13, 0.95);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 0.5rem;
      padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
      box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.3);
    }
  }

  @media (max-width: 360px) {
    .mobile-nav__item {
      padding: 0.5rem 0.4rem;
      min-width: 52px;
    }
  }

  .mobile-nav__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    min-width: 56px;
    min-height: 56px;
    color: var(--fg-muted);
    transition: all 200ms var(--ease-smooth);
    text-decoration: none;
    border-radius: 8px;
    position: relative;
  }

  .mobile-nav__item--writeups {
    display: none;
  }

  /* Match Gallery3D compact cutoff so all 5 bottom tabs map to visible sections */
  @media (max-width: 640px) {
    .mobile-nav__item--gallery {
      display: none;
    }

    .mobile-nav__item--writeups {
      display: flex;
    }
  }

  .mobile-nav__item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 50%;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 3px 3px;
    transition: transform 250ms var(--ease-out-expo);
  }

  .mobile-nav__item:active {
    background: var(--accent-dim);
    transform: scale(0.95);
  }

  .mobile-nav__item.is-active {
    color: var(--accent);
  }

  .mobile-nav__item.is-active::before {
    transform: translateX(-50%) scaleX(1);
  }

  .mobile-nav__item span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  .mobile-nav__item svg {
    transition: transform 200ms var(--ease-spring);
  }

  .mobile-nav__item.is-active svg {
    transform: scale(1.1);
  }
</style>

<script>
  let mobileNavObserver: IntersectionObserver | null = null;

  function initMobileNav() {
    const links = document.querySelectorAll('.mobile-nav__item');
    const sections = document.querySelectorAll('section[id]');

    if (sections.length === 0) return;

    mobileNavObserver?.disconnect();

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          
          links.forEach(l => {
            const targetHref = `/#${id}`;
            const linkHref = l.getAttribute('href');
            
            if (linkHref === targetHref) {
              l.classList.add('is-active');
              
              // Haptic feedback for mobile (if supported)
              if ('vibrate' in navigator) {
                navigator.vibrate(10);
              }
            } else {
              l.classList.remove('is-active');
            }
          });
        });
      },
      { rootMargin: '-15% 0px -70% 0px' }
    );

    sections.forEach(s => observer.observe(s));
    mobileNavObserver = observer;
  }

  initMobileNav();
  document.addEventListener('astro:page-load', initMobileNav);
</script>
