    private runTerminal() {
      window.dispatchEvent(new CustomEvent('terminal:open'));
    }

    private openLink(url: string) {
      window.open(url, '_blank', 'noopener,noreferrer');
    }

    // Public API
    public open() {
      const isCompact = window.matchMedia('(max-width: 640px)').matches;
      if (isCompact !== this.lastCompactViewport) {
        this.initCommands();
        this.setupFuse();
      }
      this.isOpen = true;
      this.palette.classList.add('is-open');
      this.input.value = '';
      this.render();
      this.selectedIndex = 0;
      this.updateSelection();
      
      // Focus input
      requestAnimationFrame(() => {
        this.input.focus();
      });
    }

    public close() {
      this.isOpen = false;
      this.palette.classList.remove('is-open');
      this.input.value = '';
      this.input.blur();
    }

    public toggle() {
      if (this.isOpen) {
        this.close();
      } else {
        this.open();
      }
    }
  }

  // Initialize
  let commandPalette: CommandPalette | null = null;

  function initCommandPalette() {
    const el = document.getElementById('commandPalette');
    if (!el || el.dataset.initialized === 'true') return;
    el.dataset.initialized = 'true';

    commandPalette?.destroy();
    commandPalette = new CommandPalette();

    // Expose to window for programmatic access
    (window as any).openCommandPalette = () => commandPalette?.open();
    (window as any).closeCommandPalette = () => commandPalette?.close();
  }

  initCommandPalette();
  
  document.addEventListener('astro:page-load', initCommandPalette);
</script>
